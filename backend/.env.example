# Copy this file to .env and fill in real values. .env is gitignored --
# never commit secrets. See ../docs/security.md for the full key-management
# story (why this key exists, how to rotate it, how to use a secrets
# manager instead of a local file in production).

# Which network entry of ../caatinga.artifacts.json to resolve the
# oracle contract's ID from. Must match a network deployed via `ctg deploy`.
CAATINGA_NETWORK=testnet

# Path to the Caatinga-managed artifacts file (versioned contract IDs).
# Resolved relative to the backend/ directory. Do not hardcode a contract
# ID anywhere else -- this file is the single source of truth and the
# backend re-reads it live so redeploys/upgrades are picked up with zero
# code changes and zero restarts.
CAATINGA_ARTIFACTS_PATH=../caatinga.artifacts.json

# Soroban RPC endpoint. Must match the network above.
# In a network-sandboxed CI/dev environment where the Stellar ecosystem's
# own HTTP clients do not honor HTTPS_PROXY, point this at a local
# forwarder instead (see docs/friction-log.md) -- most real deployments
# can leave this as the public RPC URL below.
RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Secret key (S...) of the Stellar CLI identity that was used as --source
# when running `ctg deploy` / `ctg upgrade` (the contract's admin). The
# backend signs set_price/upgrade transactions with this key server-side,
# since there is no interactive wallet in an automation/relayer context.
#
# NEVER commit a real value here. Get it from your local Stellar CLI
# identity store (`stellar keys show <alias>`) for a throwaway
# testnet/demo key, or from a secrets manager in production.
ORACLE_SIGNER_SECRET=S...

# Comma-separated CoinGecko asset ids -> on-chain asset symbols,
# "<coingeckoId>:<assetSymbol>" pairs.
PRICE_FEED_ASSETS=stellar:XLM,bitcoin:BTC

# How often the relayer polls the price feed and (if changed) submits
# an on-chain update, in milliseconds.
POLL_INTERVAL_MS=30000

# How often the indexer scans for new PriceUpdate events, in milliseconds.
INDEX_INTERVAL_MS=15000

# How often to re-check caatinga.artifacts.json for a changed contractId,
# in milliseconds (in addition to the fs.watch listener; a fallback poll
# is used because filesystem-change notifications are not reliable on
# every filesystem/container setup).
ARTIFACTS_POLL_INTERVAL_MS=5000

HTTP_PORT=8080

SQLITE_PATH=./data/oracle.db
